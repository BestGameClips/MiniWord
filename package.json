{
  "name": "miniword",
  "productName": "MiniWord",
  "version": "1.1.5",
  "description": "Une application de traitement de texte légère pour ordinateur.",
  "main": "src/main/main.js",
  "author": "MiniWord",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"tests/*.test.js\"",
    "check": "node scripts/check.js",
    "build": "node scripts/check.js && electron-builder --dir --publish never",
    "dist": "node scripts/check.js && electron-builder --win --publish never",
    "release": "node scripts/release.js",
    "release:dry": "node scripts/release.js --dry-run",
    "dist:linux": "node scripts/check.js && electron-builder --linux --publish never",
    "dist:mac": "node scripts/check.js && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.5.1"
  },
  "optionalDependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
